{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "contexts/*": ["src/contexts/*"],
      "hooks/*": ["src/hooks/*"],
      "routes/*": ["src/routes/*"],
      "layout/*": ["src/layout/*"],
      "themes/*": ["src/themes/*"],
      "config": ["src/config.js"]
    },
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*"]
}